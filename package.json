{
  "name": "@tweakcn/devtools",
  "version": "0.1.0",
  "description": "TanStack-style overlay to preview tweakcn shadcn themes on a running site",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/OmarHosamCodes/tweakcn-devtools.git"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./vite": {
      "types": "./dist/vite.d.ts",
      "import": "./dist/vite.js"
    }
  },
  "files": ["dist", "LICENSE", "README.md"],
  "scripts": {
    "build": "bun build src/index.tsx --outdir dist --target browser --format esm --external react --external react-dom && bun build src/vite.ts --outdir dist --target node --format esm --external vite && tsc --emitDeclarationOnly",
    "sync": "bun run scripts/sync.ts",
    "dev": "vite --config playground/vite.config.ts",
    "typecheck": "tsc --noEmit"
  },
  "peerDependencies": {
    "react": ">=18",
    "react-dom": ">=18"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "typescript": "^5.8.0",
    "vite": "^6.0.0"
  }
}
